# Copy to .env. Nothing here is required in development; every line has a
# documented default in src/config/env.ts.

PORT=4300
NODE_ENV=development

# Required in production, and the process refuses to boot without it there.
# In development a loudly-named constant is used instead so a restart does
# not sign everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated origins allowed to call this API in production. Ignored in
# development, where any origin is accepted so the Vite dev server on any
# port works.
CORS_ORIGINS=

# Run transcribe/dub/render against the built-in simulator instead of a real
# provider. Defaults to true outside production and false in production.
# Every job and every artefact it produces is stamped simulated:true.
STUDIO_SIMULATE_JOBS=true

# How long a simulated job takes, end to end, in milliseconds.
STUDIO_SIMULATE_MS=3000

# Script writing for the Director. Leave empty and the editor still cuts a
# script you paste -- only "write it for me" and "tighten" need a model.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to the light model named in
# apps/studio/src/lib/scenes.ts (claude-haiku-5-5), which is the right size
# for short structured jobs like cutting a script into scenes.
STUDIO_AI_MODEL=

# Optional. The model for writing -- hooks, scripts, rewrites and ideas.
# Defaults to claude-sonnet-5-5: a stronger writer than the light model, at
# about $2 / $10 per million tokens in / out. Set it to claude-opus-5-5 for
# the best writing at roughly twice the cost.
STUDIO_WRITER_MODEL=

# ── AI video: Runway ──────────────────────────────────────────────────
# Optional, and billable: Gen-4.5 costs 12 credits ($0.12) per second
# generated, moderated attempts included. Empty means the feature is off.
# Each plan's monthly seconds are in apps/studio/src/lib/catalogue.ts
# (videoSecondsPerMonth). Keys: https://dev.runwayml.com
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4.5

# ── Payments: Cashfree ────────────────────────────────────────────────
# Both or neither. With neither, the app runs in test mode: plans are
# chosen without payment and every screen says so. Keys are in the
# Cashfree dashboard under Developers -> API keys; use the sandbox pair
# first and switch CASHFREE_ENV when you go live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
# Add USD only once international payments are enabled on the account.
CASHFREE_CURRENCIES=INR

# Where the web app and this API are reachable. PUBLIC_API_URL must be
# https for Cashfree's webhook and for the Instagram and TikTok sign-in
# callbacks. Register these addresses with each platform:
#   <PUBLIC_API_URL>/api/billing/webhook/cashfree        (Cashfree webhooks)
#   <PUBLIC_API_URL>/api/connections/instagram/callback
#   <PUBLIC_API_URL>/api/connections/youtube/callback
#   <PUBLIC_API_URL>/api/connections/tiktok/callback
PUBLIC_WEB_URL=http://localhost:5179
PUBLIC_API_URL=

# ── Connections, for Insights and Ideas (read-only) ───────────────────
# Instagram API with Instagram Login (Meta developer app, Instagram
# product). Business or creator accounts only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Google Cloud OAuth client, YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok for Developers app with Login Kit and the Display API. Offered
# to accounts outside India only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 32 bytes, base64, encrypts platform tokens at rest. Required in
# production once any platform above is set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Operator access (admin routes). Comma-separated emails; there is no
# endpoint that grants it.
STUDIO_ADMIN_EMAILS=
